# .env.example - Template for Retriva Gateway environment variables
# Copy this file to .env and customize the values for your setup

# --- Gateway Server Settings ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8002

# --- Retriva Core API URLs ---
# Ingestion API endpoint (corresponds to core INGESTION_API_PORT)
RETRIVA_CORE_INGESTION_URL=http://localhost:8000
# Chat/OpenAI-compatible API endpoint (corresponds to core OPENAI_API_PORT)
RETRIVA_CORE_CHAT_URL=http://localhost:8001

# --- Authentication ---
# Which auth provider to use. "none" = no authentication (default).
# Other values (e.g. "entra") require the corresponding Retriva Pro package
# installed in the Gateway's Python environment.
RETRIVA_AUTH_PROVIDER=none
# Paths that bypass authentication (comma-separated or JSON array, prefix match).
RETRIVA_AUTH_EXEMPT_PATHS=/health,/ready,/capabilities

# --- Features & Capabilities ---
GATEWAY_ENABLE_ARTIFACTS=true
GATEWAY_ENABLE_FOLDER_UPLOAD=true
GATEWAY_ENABLE_SPEECH_INPUT=false

# --- Upload Settings ---
GATEWAY_MAX_UPLOAD_MB=500
GATEWAY_UPLOAD_TMP_DIR=/tmp/retriva-gateway-uploads

# --- CORS Settings ---
# JSON array of allowed origins for web clients
GATEWAY_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:5174"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Speech-to-Text (Whisper) ---
# Enable the /stt/transcribe proxy endpoint
STT_ENABLED=true
# Full URL to the whisper.cpp whisper-server /inference endpoint
WHISPER_SERVER_URL=http://127.0.0.1:8080/inference
# Maximum audio upload size in bytes (default 20 MiB)
STT_MAX_AUDIO_BYTES=20971520
# Timeout for the whisper-server request in seconds
STT_REQUEST_TIMEOUT_SECONDS=120

# --- Dynamic Ingestion (Connected Sources) ---
# Enable the /sources API for dynamic ingestion
DYNAMIC_INGESTION_ENABLED=true
# Directory for persistent source data (JSON files)
DYNAMIC_INGESTION_DATA_DIR=/tmp/retriva-gateway-dynamic-sources
# Comma-separated list of allowed connector types
ALLOWED_CONNECTOR_TYPES=["mediawiki"]
# Default tenant ID for all source records
DEFAULT_TENANT_ID=internal-company
# Service token for internal worker endpoints (empty = auth disabled)
INTERNAL_SERVICE_TOKEN=

# --- Hybrid intent routing — classifier policy (Spec 001 Phase D; C7) -----
# Untrusted advisory classifier; off/streaming never invoke it.  The
# transport (provider/model/endpoint/region/credentials) is Core's
# deployment-global configuration — the Gateway never selects it per
# request.  Disabled by default (constitution §18).
AGENT_INTENT_CLASSIFIER_ENABLED=false
# Minimum accepted confidence for any active-mode recommendation
# (accepted range [0.50, 1.00]).
AGENT_INTENT_CLASSIFIER_MIN_CONFIDENCE=0.85
# Minimum accepted confidence for active-mode SAFE-workflow
# recommendations (must be >= MIN_CONFIDENCE).
AGENT_INTENT_CLASSIFIER_SAFE_WORKFLOW_MIN_CONFIDENCE=0.90
# Deterministic truncation bound for the classification message.
AGENT_INTENT_CLASSIFIER_MAX_INPUT_CHARS=2000
# Categorical context bound (Phase D hints).
AGENT_INTENT_CLASSIFIER_MAX_CONTEXT_TURNS=4
# Fail mode: 'clarify' is the only permitted value.
AGENT_INTENT_CLASSIFIER_FAIL_MODE=clarify
# Dedicated internal service credential for the Core classification
# endpoint (must equal Core's INTENT_CLASSIFIER_SERVICE_AUTH_TOKEN;
# never reused from another service; secret reference only).
AGENT_INTENT_CLASSIFIER_SERVICE_AUTH_TOKEN=""
